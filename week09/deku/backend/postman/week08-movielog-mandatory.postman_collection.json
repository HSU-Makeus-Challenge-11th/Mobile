        },
        "body": {
          "mode": "raw",
          "raw": "{\"movieId\":550}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));",
              "pm.test(\"movieId와 favoriteId\", () => { const r = pm.response.json().result; pm.expect(r.movieId).to.eql(550); pm.expect(r.favoriteId).to.be.above(0); });",
              "pm.test(\"createdAt\", () => pm.expect(pm.response.json().result.createdAt).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },
