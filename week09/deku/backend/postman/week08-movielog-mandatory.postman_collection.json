{
  "info": {
    "name": "UMC Week08 MovieLog Mandatory Scenario",
    "description": "순서대로 실행합니다. 회원가입에서 고유 runId를 만들고 로그인 응답 토큰을 컬렉션 변수 tokenA에 저장합니다. 캡처 시 토큰과 비밀번호를 가리세요. 서버 기본 주소는 http://localhost:8080 입니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 회원가입 (새 계정)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"a-{{runId}}@umc.com\",\"password\":\"Password!1\",\"nickname\":\"A{{runId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-10));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 로그인 (토큰 저장)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"a-{{runId}}@umc.com\",\"password\":\"Password!1\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"tokenA\", pm.response.json().result.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 등록 전 여부 false",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/favorites/550",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "favorites",
            "550"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.test(\"등록 전 false\", () => pm.expect(pm.response.json().result.isFavorite).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 즐겨찾기 등록",
