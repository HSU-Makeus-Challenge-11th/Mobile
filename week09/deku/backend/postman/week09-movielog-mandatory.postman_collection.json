              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "const ratings = pm.response.json().result;",
              "pm.test(\"실패한 영화 550 평점 없음\", () => pm.expect(ratings.some(r => r.movieId === 550)).to.be.false);",
              "pm.test(\"성공한 영화 560 평점 있음\", () => pm.expect(ratings.some(r => r.movieId === 560)).to.be.true);"
            ]
