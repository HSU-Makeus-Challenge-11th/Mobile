{
  "info": {
    "name": "UMC Week09 MovieLog Swagger and Regression Scenario",
    "description": "01부터 12까지 순서대로 실행합니다. 01이 새 계정을 만들고 02가 tokenA를 저장합니다. 로컬 서버만 대상으로 사용하고 토큰·비밀번호는 캡처에서 가리세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 회원가입 (새 계정)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"a-{{runId}}@umc.com\",\"password\":\"Password!1\",\"nickname\":\"A{{runId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));",
              "pm.collectionVariables.set(\"memberId\", pm.response.json().result.memberId);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-10));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 로그인 (토큰 저장)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"a-{{runId}}@umc.com\",\"password\":\"Password!1\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"tokenA\", pm.response.json().result.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 OpenAPI 문서 공개/인증 확인",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v3/api-docs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v3",
            "api-docs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const spec = pm.response.json();",
              "pm.test(\"Bearer 인증 스키마\", () => pm.expect(spec.components.securitySchemes.bearerAuth.scheme).to.eql(\"bearer\"));",
              "pm.test(\"회원가입은 공개\", () => pm.expect(spec.paths[\"/members\"].post.security).to.be.undefined);",
              "pm.test(\"로그인은 공개\", () => pm.expect(spec.paths[\"/auth/login\"].post.security).to.be.undefined);",
              "pm.test(\"즐겨찾기는 인증 필요\", () => pm.expect(spec.paths[\"/favorites\"].post.security[0]).to.have.property(\"bearerAuth\"));",
              "pm.test(\"평점 등록은 인증 필요\", () => pm.expect(spec.paths[\"/ratings\"].post.security[0]).to.have.property(\"bearerAuth\"));"
            ]
          }
        }
      ]
    },
