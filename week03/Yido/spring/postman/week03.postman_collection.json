{
  "info": {
    "name": "UMC Week03 Spring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }],
  "item": [
    { "name": "전체 도서 조회", "request": { "method": "GET", "url": "{{baseUrl}}/books" } },
    { "name": "도서 등록", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"클린 코드\",\n  \"description\": \"애자일 소프트웨어 장인 정신\"\n}" }, "url": "{{baseUrl}}/books" } },
    { "name": "카테고리별 도서 조회", "request": { "method": "GET", "url": "{{baseUrl}}/books/category/1" } },
    { "name": "도서 대여", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"bookId\": 1\n}" }, "url": "{{baseUrl}}/rentals" } }
  ]
}
