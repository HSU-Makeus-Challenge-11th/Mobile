      "name": "01 회원 A 가입 201",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/members",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a@umc.com\",\n  \"password\": \"Umc1234!\",\n  \"nickname\": \"영화광A\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 COMMON201', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().code).to.eql('COMMON201');",
              "});"
            ]
          }
        }
      ]
    },
