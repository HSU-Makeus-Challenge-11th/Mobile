    {
      "name": "03 A 로그인 200",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a@umc.com\",\n  \"password\": \"Umc1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 COMMON200', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().code).to.eql('COMMON200');",
              "});",
              "pm.collectionVariables.set('tokenA', pm.response.json().result.accessToken);",
              "const parts = pm.response.json().result.accessToken.split('.');",
              "const mid = Math.floor(parts[1].length / 2);",
              "const ch = parts[1][mid] === 'A' ? 'B' : 'A';",
              "parts[1] = parts[1].slice(0, mid) + ch + parts[1].slice(mid + 1);",
              "pm.collectionVariables.set('forgedToken', parts.join('.'));"
            ]
          }
        }
      ]
    },
