      "name": "01 A 로그인 200",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a@umc.com\",\n  \"password\": \"Umc1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 COMMON200', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().code).to.eql('COMMON200');",
              "});",
              "pm.collectionVariables.set('tokenA', pm.response.json().result.accessToken);"
            ]
          }
        }
      ]
    },
