{
  "info": {
    "name": "UMC Week04 Spring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 도서 목록 조회 (GET 성공)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "02 도서 등록 (POST 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"클린 코드\",\n  \"description\": \"애자일 소프트웨어 장인 정신\"\n}"
        },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "03 빈 제목 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"\",\n  \"description\": \"제목 없음\"\n}"
        },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "04 없는 카테고리 (404)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": 999,\n  \"title\": \"없는 카테고리 도서\",\n  \"description\": \"등록되면 안 됨\"\n}"
        },
        "url": "{{baseUrl}}/books"
      }
    }
  ]
}